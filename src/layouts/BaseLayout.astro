---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import interLatin400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import interLatin800 from '@fontsource/inter/files/inter-latin-800-normal.woff2?url';
import '../styles/global.css';
import { siteConfig } from '../config/site';
import SeoHead from '../components/seo/SeoHead.astro';
import TrackInteractions from '../components/analytics/TrackInteractions.astro';
import CookieConsent from '../components/CookieConsent.astro';

const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  path = Astro.url.pathname,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href={interLatin400} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={interLatin800} crossorigin="anonymous" />
    {
      path === '/' && (
        <link
          rel="preload"
          as="image"
          type="image/webp"
          href="/hero-1280.webp"
          imagesrcset="/hero-640.webp 640w, /hero-960.webp 960w, /hero-1280.webp 1280w, /hero-1600.webp 1600w"
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }
    <link rel="icon" href={siteConfig.assets.favicon} type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href={siteConfig.assets.favicon32} />
    <link rel="icon" type="image/png" sizes="192x192" href={siteConfig.assets.favicon192} />
    <link rel="apple-touch-icon" sizes="180x180" href={siteConfig.assets.faviconApple} />
    <title>{title}</title>
    <SeoHead title={title} description={description} path={path} noindex={noindex} />
  </head>
  <body class="min-h-screen bg-white">
    <slot />
    <TrackInteractions />
    <CookieConsent measurementId={measurementId} />
    <script>
      const menuButton = document.getElementById('menu-button');
      const menuPanel = document.getElementById('menu-mobile');

      function setMenuOpen(open: boolean) {
        if (!(menuButton instanceof HTMLButtonElement)) return;
        if (!(menuPanel instanceof HTMLElement)) return;
        menuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) menuPanel.removeAttribute('hidden');
        else menuPanel.setAttribute('hidden', '');
      }

      menuButton?.addEventListener('click', () => {
        setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true');
      });

      menuPanel?.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest('a')) setMenuOpen(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuOpen(false);
      });
    </script>
  </body>
</html>
